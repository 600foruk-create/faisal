Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Block internal source, database, build, and config files from public HTTP access
RewriteRule ^(src|tests|scripts|data|node_modules|\.next|\.git)(/|$) - [F,L]
RewriteRule ^api/(config\.local\.php|config\.example\.php|schema_mysql\.sql|db\.php|fbr\.php|seed\.php|pos_service\.php)$ - [F,L]
RewriteRule ^(package\.json|package-lock\.json|tsconfig\.json|next\.config\.ts|postcss\.config\.mjs|\.gitignore|README\.md)$ - [F,L]

# Route /api/* requests to PHP API router
RewriteCond %{REQUEST_URI} !^/api/index\.php$
RewriteRule ^api/(.+)$ api/index.php?route=$1 [QSA,L]
</IfModule>
